# Enhanced Alpine Dockerfile with comprehensive shell support
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install comprehensive shell and development tools
RUN apk update && apk add --no-cache \
    # Shell tools
    bash \
    ash \
    dash \
    zsh \
    # Essential tools
    git \
    openssh \
    curl \
    wget \
    # Build tools (in case needed for native modules)
    make \
    gcc \
    g++ \
    python3 \
    # System tools
    ca-certificates \
    tzdata \
    coreutils \
    findutils \
    && rm -rf /var/cache/apk/*

# Create shell symlinks for better compatibility
RUN ln -sf /bin/bash /usr/bin/bash && \
    ln -sf /bin/ash /usr/bin/ash && \
    ln -sf /bin/sh /usr/bin/sh

# Verify shell installations
RUN echo "=== Shell verification ===" && \
    ls -la /bin/*sh* /usr/bin/*sh* 2>/dev/null || true && \
    echo "Testing bash:" && bash -c "echo 'bash works'" && \
    echo "Testing ash:" && ash -c "echo 'ash works'" && \
    echo "Testing sh:" && sh -c "echo 'sh works'" && \
    echo "Testing busybox:" && /bin/busybox sh -c "echo 'busybox works'" && \
    echo "=== End verification ===" 

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install pnpm and dependencies
RUN npm install -g pnpm && pnpm install

# Copy source code
COPY . .

# Build the application
RUN pnpm build

# Add a diagnostic script for runtime shell testing
RUN echo '#!/bin/bash' > /app/shell-test.sh && \
    echo 'echo "=== Runtime Shell Test ==="' >> /app/shell-test.sh && \
    echo 'echo "Platform: $(uname -a)"' >> /app/shell-test.sh && \
    echo 'echo "Available shells:"' >> /app/shell-test.sh && \
    echo 'ls -la /bin/*sh* /usr/bin/*sh* 2>/dev/null || echo "No shell files found"' >> /app/shell-test.sh && \
    echo 'echo "Testing shells:"' >> /app/shell-test.sh && \
    echo 'for shell in bash ash sh; do' >> /app/shell-test.sh && \
    echo '  echo -n "Testing $shell: "' >> /app/shell-test.sh && \
    echo '  if command -v $shell >/dev/null 2>&1; then' >> /app/shell-test.sh && \
    echo '    echo "Available"' >> /app/shell-test.sh && \
    echo '  else' >> /app/shell-test.sh && \
    echo '    echo "Not available"' >> /app/shell-test.sh && \
    echo '  fi' >> /app/shell-test.sh && \
    echo 'done' >> /app/shell-test.sh && \
    echo 'echo "=== End Test ==="' >> /app/shell-test.sh && \
    chmod +x /app/shell-test.sh

# Expose port
EXPOSE 3000

# Start the application
CMD ["node", "dist/server.js"]