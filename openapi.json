    "/projects/{projectId}/files/diff": {
      "patch": {
        "summary": "Apply Unified Diff",
        "operationId": "applyUnifiedDiff",
        "description": "Apply a traditional unified diff patch. Use for complex changes when you have a proper diff format.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "patch": {
                    "type": "string",
                    "description": "Unified diff patch content"
                  },
                  "fuzz_factor": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Fuzz factor for patch matching (0-10)"
                  },
                  "auto_convert_line_endings": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically convert line endings"
                  },
                  "expected_hash": {
                    "type": "string",
                    "description": "Expected SHA256 hash for validation"
                  },
                  "preview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preview changes without applying them"
                  }
                },
                "required": ["path", "patch"]
              },
              "examples": {
                "apply_diff": {
                  "summary": "Apply a unified diff",
                  "value": {
                    "path": "src/example.ts",
                    "patch": "--- a/src/example.ts\n+++ b/src/example.ts\n@@ -1,3 +1,3 @@\n-const old = 'value';\n+const new = 'value';",
                    "preview": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File patched successfully with diff operation."
          }
        }
      }
    },
