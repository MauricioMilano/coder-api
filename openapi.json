                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Character position to insert at (0-based)"
                  },
                  "content": {
                    "type": "string",
