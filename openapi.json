{
  "openapi": "3.1.1",
  "info": {
    "title": "Coder API",
    "description": "Collection of Coder API routes for use in Postman.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://25a7d825a182.ngrok-free.app"
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "summary": "List Projects",
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "Project list returned successfully."
          }
        }
      },
      "post": {
        "summary": "Create Project",
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "oneOf": [
                      {"type": "object", "properties": {"git": {"type": "object", "properties": {"url": {"type": "string"}, "branch": {"type": "string"}, "depth": {"type": "number"}, "token_env": {"type": "string"}}}}},
                      {"type": "object", "properties": {"local": {"type": "object", "properties": {"mount": {"type": "string"}, "path": {"type": "string"}}}}},
                      {"type": "object", "properties": {"archiveUrl": {"type": "string", "format": "uri"}, "extract_to": {"type": "string"}}},
                      {"type": "object", "properties": {"adopt": {"type": "object", "properties": {"path": {"type": "string"}}}}}
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Project name. Used to generate a friendly project_id and folder name."
                  }
                },
                "required": ["source", "name"]
              },
              "examples": {
                "git": {
                  "summary": "Add project from a public Git repository",
                  "value": {
                    "source": {
                      "git": {
                        "url": "https://github.com/mauriciomilano/coder-api.git",
                        "branch": "main"
                      }
                    },
                    "name": "coder-api-git"
                  }
                },
                "git-private": {
                  "summary": "Add project from a private Git repository with token",
                  "value": {
                    "source": {
                      "git": {
                        "url": "https://github.com/username/private-repo.git",
                        "branch": "main",
                        "token_env": "GITHUB_TOKEN"
                      }
                    },
                    "name": "my-private-project"
                  }
                },
                "local": {
                  "summary": "Add project from a mounted local directory",
                  "value": {
                    "source": {
                      "local": {
                        "mount": "workbench",
                        "path": "/my-project"
                      }
                    },
                    "name": "my-local-project"
                  }
                },
                "archiveUrl": {
                  "summary": "Add project from an archive file (not implemented)",
                  "value": {
                    "source": {
                      "archiveUrl": "https://mysite.com/project.zip",
                      "extract_to": "/"
                    },
                    "name": "project-zip"
                  }
                },
                "adopt": {
                  "summary": "Adopt an existing directory from the filesystem",
                  "value": {
                    "source": {
                      "adopt": {
                        "path": "/srv/workspace/projects/already-existing"
                      }
                    },
                    "name": "existing-project"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully."
          }
        }
      }
    },
    "/projects/{projectId}": {
      "patch": {
        "summary": "Edit Project Name",
        "operationId": "editProjectName",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Current project_id (slug)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "New project name. Will update project_id and folder if changed."
                  }
                },
                "required": ["name"]
              },
              "example": {
                "name": "novo-nome-do-projeto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project name updated successfully. Returns new project_id, name, and root."
          },
          "400": {"description": "Invalid new name."},
          "404": {"description": "Project not found."},
          "500": {"description": "Failed to rename folder."}
        }
      }
    },
    "/projects/{projectId}/filetree": {
      "get": {
        "summary": "List Filetree",
        "operationId": "listFiletree",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "glob",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_entries",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File tree listed successfully."
          }
        }
      }
    },
    "/projects/{projectId}/files": {
      "get": {
        "summary": "Read Project File",
        "operationId": "readProjectFile",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "encoding",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content returned."
          }
        }
      },
      "post": {
        "summary": "Create Project File",
        "operationId": "createProjectFile",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "encoding": {
                    "type": "string"
                  },
                  "create_parents": {
                    "type": "boolean"
                  },
                  "overwrite": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File created successfully."
          }
        }
      },
      "patch": {
        "summary": "Edit Project File",
        "operationId": "editProjectFile",
        "description": "File editing endpoint with multiple operation types for different editing scenarios.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "expected_hash": {
                    "type": "string",
                    "description": "Optional sha256 hash of the current file contents for validation."
                  },
                  "preview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preview changes without applying them. Returns diff preview and stats."
                  },
                  "operation": {
                    "oneOf": [
                      {
                        "type": "object",
                        "title": "Traditional Diff Patch",
                        "properties": {
                          "type": { "type": "string", "enum": ["diff"] },
                          "patch": { "type": "string", "description": "Unified diff to apply" },
                          "fuzz_factor": { "type": "integer", "default": 0, "minimum": 0, "maximum": 10 },
                          "auto_convert_line_endings": { "type": "boolean", "default": true }
                        },
                        "required": ["type", "patch"]
                      },
                      {
                        "type": "object",
                        "title": "Find and Replace",
                        "properties": {
                          "type": { "type": "string", "enum": ["replace"] },
                          "find": { "type": "string", "description": "Text to find" },
                          "replace": { "type": "string", "description": "Text to replace with" },
                          "all": { "type": "boolean", "default": false, "description": "Replace all occurrences" },
                          "case_sensitive": { "type": "boolean", "default": true },
                          "regex": { "type": "boolean", "default": false, "description": "Treat find as regex" }
                        },
                        "required": ["type", "find", "replace"]
                      },
                      {
                        "type": "object",
                        "title": "Line-based Operations",
                        "properties": {
                          "type": { "type": "string", "enum": ["lines"] },
                          "action": { "type": "string", "enum": ["insert", "delete", "replace"] },
                          "line_number": { "type": "integer", "minimum": 1, "description": "1-indexed line number" },
                          "count": { "type": "integer", "minimum": 1, "default": 1, "description": "Number of lines to affect" },
                          "content": { "type": "string", "description": "Content for insert/replace operations" }
                        },
                        "required": ["type", "action", "line_number"]
                      },
                      {
                        "type": "object",
                        "title": "Character Position Insert",
                        "properties": {
                          "type": { "type": "string", "enum": ["insert"] },
                          "position": { "type": "integer", "minimum": 0, "description": "Character position in file" },
                          "content": { "type": "string", "description": "Content to insert" }
                        },
                        "required": ["type", "position", "content"]
                      },
                      {
                        "type": "object",
                        "title": "Smart Code Block Replacement",
                        "properties": {
                          "type": { "type": "string", "enum": ["code_block"] },
                          "language": { "type": "string", "description": "Programming language for context" },
                          "find_context": { "type": "string", "description": "Context to identify the code block" },
                          "replace_with": { "type": "string", "description": "New code block content" },
                          "fuzzy_match": { "type": "boolean", "default": true, "description": "Allow fuzzy matching" }
                        },
                        "required": ["type", "find_context", "replace_with"]
                      }
                    ]
                  }
                },
                "required": ["path", "operation"]
              },
              "examples": {
                "find_replace": {
                  "summary": "Simple find and replace",
                  "value": {
                    "path": "src/example.ts",
                    "operation": {
                      "type": "replace",
                      "find": "import { Communication }",
                      "replace": "import CommunicationPage",
                      "case_sensitive": true
                    }
                  }
                },
                "line_insert": {
                  "summary": "Insert lines at specific position",
                  "value": {
                    "path": "src/config.ts",
                    "operation": {
                      "type": "lines",
                      "action": "insert",
                      "line_number": 5,
                      "content": "// New configuration option\nexport const DEBUG_MODE = true;"
                    }
                  }
                },
                "code_block_replace": {
                  "summary": "Smart code block replacement",
                  "value": {
                    "path": "src/api.ts",
                    "operation": {
                      "type": "code_block",
                      "language": "typescript",
                      "find_context": "function processData",
                      "replace_with": "async function processData(data: any) {\n  return await enhancedProcessor(data);\n}",
                      "fuzzy_match": true
                    }
                  }
                },
                "preview_mode": {
                  "summary": "Preview changes before applying",
                  "value": {
                    "path": "src/example.ts",
                    "preview": true,
                    "operation": {
                      "type": "replace",
                      "find": "old function",
                      "replace": "new function"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File edited successfully or preview generated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "hash": { "type": "string" },
                    "bytes_before": { "type": "integer" },
                    "bytes_after": { "type": "integer" },
                    "preview": { "type": "boolean", "description": "True if this was a preview request" },
                    "original_hash": { "type": "string", "description": "Hash of original content (preview mode)" },
                    "modified_hash": { "type": "string", "description": "Hash of modified content (preview mode)" },
                    "diff_preview": { "type": "string", "description": "Preview of changes (preview mode)" },
                    "stats": {
                      "type": "object",
                      "description": "Operation-specific statistics",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid operation or parameters." },
          "409": { "description": "Hash mismatch or operation could not be applied." },
          "422": { "description": "Validation error in request payload." }
        }
      },
      "delete": {
        "summary": "Delete Project File/Folder",
        "operationId": "deleteProjectPath",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "recursive": {
                    "type": "boolean"
                  },
                  "missing_ok": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File or folder deleted successfully."
          }
        }
      }
    },
    "/projects/{projectId}/files/replace": {
      "patch": {
        "summary": "Replace Text in File",
        "operationId": "replaceTextInFile",
        "description": "Find and replace text in a file. Use for simple text substitutions, imports, variable names.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "find": {
                    "type": "string",
                    "description": "Text to find and replace"
                  },
                  "replace": {
                    "type": "string",
                    "description": "Replacement text"
                  },
                  "all": {
                    "type": "boolean",
                    "default": false,
                    "description": "Replace all occurrences, not just the first"
                  },
                  "case_sensitive": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the search is case sensitive"
                  },
                  "regex": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to treat find pattern as regex"
                  },
                  "expected_hash": {
                    "type": "string",
                    "description": "Expected SHA256 hash for validation"
                  },
                  "preview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preview changes without applying them"
                  }
                },
                "required": ["path", "find", "replace"]
              },
              "examples": {
                "simple_replace": {
                  "summary": "Simple text replacement",
                  "value": {
                    "path": "src/config.ts",
                    "find": "const PORT = 3000",
                    "replace": "const PORT = 8080"
                  }
                },
                "import_replace": {
                  "summary": "Replace import statement",
                  "value": {
                    "path": "src/app.ts",
                    "find": "import express from 'express'",
                    "replace": "import express, { Request, Response } from 'express'",
                    "preview": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File patched successfully with replace operation."
          }
        }
      }
    },
    "/projects/{projectId}/files/lines": {
      "patch": {
        "summary": "Line-based Operations on File",
        "operationId": "linesOperationOnFile",
        "description": "Insert, delete, or replace specific lines in a file. Use for adding imports, deleting code blocks.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "action": {
                    "type": "string",
                    "enum": ["insert", "delete", "replace"],
                    "description": "Action to perform on lines"
                  },
                  "line_number": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Line number to operate on (1-based)"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Number of lines to delete/replace (for delete/replace actions)"
                  },
                  "content": {
                    "type": "string",
                    "description": "Content to insert/replace (for insert/replace actions)"
                  },
                  "expected_hash": {
                    "type": "string",
                    "description": "Expected SHA256 hash for validation"
                  },
                  "preview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preview changes without applying them"
                  }
                },
                "required": ["path", "action", "line_number"]
              },
              "examples": {
                "insert_line": {
                  "summary": "Insert a new line",
                  "value": {
                    "path": "src/app.ts",
                    "action": "insert",
                    "line_number": 3,
                    "content": "import { config } from './config';"
                  }
                },
                "delete_lines": {
                  "summary": "Delete multiple lines",
                  "value": {
                    "path": "src/utils.ts",
                    "action": "delete",
                    "line_number": 10,
                    "count": 3,
                    "preview": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File patched successfully with lines operation."
          }
        }
      }
    },
    "/projects/{projectId}/files/code-block": {
      "patch": {
        "summary": "Smart Code Block Replacement",
        "operationId": "codeBlockReplacement",
        "description": "Smart replacement of code blocks, functions, or classes. Use for replacing entire functions or code structures.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path of the file to be edited, relative to the project root."
                  },
                  "find_context": {
                    "type": "string",
                    "description": "Context to identify the code block (e.g., function name, class name)"
                  },
                  "replace_with": {
                    "type": "string",
                    "description": "New code block content"
                  },
                  "fuzzy_match": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow fuzzy matching for context"
                  },
                  "language": {
                    "type": "string",
                    "description": "Programming language for better context understanding"
                  },
                  "expected_hash": {
                    "type": "string",
                    "description": "Expected SHA256 hash for validation"
                  },
                  "preview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Preview changes without applying them"
                  }
                },
                "required": ["path", "find_context", "replace_with"]
              },
              "examples": {
                "replace_function": {
                  "summary": "Replace a function",
                  "value": {
                    "path": "src/utils.ts",
                    "find_context": "function calculateSum",
                    "replace_with": "function calculateSum(numbers: number[]): number {\n  return numbers.reduce((sum, num) => sum + num, 0);\n}",
                    "language": "typescript",
                    "preview": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File patched successfully with code block operation."
          }
        }
      }
    },
    "/projects/{projectId}/files/insert": {
      "patch": {
        "summary": "Insert at Character Position",
        "operationId": "insertAtPosition",
