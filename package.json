{
  "name": "coder-api",
  "version": "0.1.0",
  "description": "MVP backend para agente autônomo de modificação de projetos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "dev:frontend": "cd frontend && pnpm dev",
    "tunnel": "ts-node start-with-tunnel.ts",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && pnpm install && pnpm build",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ngrok": "^5.0.0-beta.2",
    "pino": "^8.17.0",
    "pm2": "^5.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
